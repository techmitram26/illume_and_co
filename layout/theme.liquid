<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#181818">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains 'Illume & Co' %} &ndash; Illume &amp; Co Luxury Lighting Pune{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="Illume &amp; Co — Curated luxury decorative and architectural commercial lighting in Pune. Chandeliers, pendant lights, magnetic tracks, and bespoke lighting fixtures.">
    {% endif %}

    <!-- Open Graph / Meta -->
    <meta property="og:site_name" content="Illume &amp; Co">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | default: 'Illume &amp; Co — The Art of Illumination' }}">
    <meta property="og:type" content="website">
    <meta property="og:description" content="{{ page_description | default: 'The Art of Illumination — Curated decorative chandeliers, wall lights, and architectural lighting.' | escape }}">

    <!-- Client Palette 1: Timeless Elegance (Charcoal, Ivory, Muted Gold, Taupe) -->
    <style>
      :root {
        --color-gold: {{ settings.color_primary | default: '#B69A70' }};
        --color-gold-hover: {{ settings.color_primary_hover | default: '#9E835B' }};
        --color-gold-light: rgba(182, 154, 112, 0.12);
        --color-gold-glow: rgba(182, 154, 112, 0.28);
        --color-primary: {{ settings.color_primary | default: '#B69A70' }};
        --color-primary-hover: {{ settings.color_primary_hover | default: '#9E835B' }};
        --color-ink: {{ settings.color_text_dark | default: '#292929' }};
        --color-charcoal: {{ settings.color_dark_bg | default: '#292929' }};
        --color-taupe: {{ settings.color_text_muted | default: '#8A8175' }};
        --color-muted: {{ settings.color_text_muted | default: '#8A8175' }};
        --color-cream: {{ settings.color_bg_cream | default: '#F3EFE6' }};
        --color-ivory: {{ settings.color_bg_cream | default: '#F3EFE6' }};
        --color-alabaster: {{ settings.color_bg_cream | default: '#F3EFE6' }};
        --color-surface: {{ settings.color_bg_cream | default: '#F3EFE6' }};
        --color-surface-tint: {{ settings.color_bg_cream | default: '#F3EFE6' }};
        --color-border: {{ settings.color_border | default: '#DFD8CC' }};
        --color-white: #FFFFFF;
      }
    </style>

    <!-- CSS -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <!-- Structured Data: LocalBusiness & Organization -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "HomeGoodsStore",
        "name": "Illume & Co",
        "description": "Luxury decorative and commercial lighting showroom and e-commerce store in Pune.",
        "url": "{{ shop.url }}",
        "telephone": "+91-8983404458",
        "email": "enlighteningworld01@gmail.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "354, Budhwar Peth, Near Pasodya Vithoba Temple",
          "addressLocality": "Pune",
          "addressRegion": "Maharashtra",
          "postalCode": "411002",
          "addressCountry": "IN"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "18.5167",
          "longitude": "73.8562"
        },
        "priceRange": "₹₹₹"
      }
    </script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <!-- Announcement Bar -->
    {% section 'announcement-bar' %}

    <!-- Header & Mega Menu -->
    {% section 'header' %}

    <!-- Main Content -->
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer -->
    {% section 'footer' %}

    <!-- Floating WhatsApp Concierge -->
    {% if settings.enable_whatsapp_floating %}
      {% render 'whatsapp-button' %}
    {% endif %}

    <!-- Slide-over Cart Drawer -->
    <div class="cart-drawer-overlay"></div>
    <aside class="cart-drawer" role="dialog" aria-modal="true" aria-label="Shopping Bag">
      <div class="cart-drawer-header">
        <h2 class="cart-drawer-title">Shopping Bag</h2>
        <button type="button" class="header-action-btn" data-close-cart aria-label="Close bag">
          {% render 'icon', name: 'close' %}
        </button>
      </div>

      <div class="cart-drawer-items" id="cart-drawer-items">
        {% if cart.item_count == 0 %}
          <div class="cart-empty-state" style="text-align: center; padding: 60px 20px;">
            <p style="color: var(--color-muted); margin-bottom: 24px; font-size: 14.5px;">Your luxury shopping bag is empty.</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline-gold" data-close-cart style="padding: 10px 24px; font-size: 11px;">Explore Catalogue</a>
          </div>
        {% else %}
          {% for item in cart.items %}
            <div class="cart-item" data-item-key="{{ item.key }}" style="display: flex; gap: 16px; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--color-border); align-items: flex-start;">
              <a href="{{ item.url }}" style="flex-shrink: 0; width: 75px; height: 90px; overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--color-border); background: #F3EFE6; display: flex; align-items: center; justify-content: center;">
                <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title }}" width="75" height="90" style="width: 100%; height: 100%; object-fit: cover;">
              </a>
              <div style="flex-grow: 1; min-width: 0;">
                <h4 style="font-size: 15px; margin: 0 0 4px; font-family: var(--font-serif); line-height: 1.3;">
                  <a href="{{ item.url }}" style="text-decoration: none; color: var(--color-ink);">{{ item.product.title }}</a>
                </h4>
                {% if item.sku != blank %}
                  <div style="font-size: 11px; color: var(--color-primary-hover); font-weight: 600; margin-bottom: 4px;">SKU: {{ item.sku }}</div>
                {% endif %}
                {% if item.variant.title != blank and item.variant.title != 'Default Title' %}
                  <div style="font-size: 11.5px; color: var(--color-muted); margin-bottom: 6px;">{{ item.variant.title }}</div>
                {% endif %}
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
                  <div class="cart-qty-selector" style="display: inline-flex; align-items: center; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #FFF;">
                    <button type="button" class="cart-qty-btn" data-change="-1" data-key="{{ item.key }}" data-qty="{{ item.quantity }}" style="background: none; border: none; padding: 4px 10px; cursor: pointer; font-size: 14px; color: var(--color-ink);" aria-label="Decrease quantity">−</button>
                    <span style="font-size: 12px; font-weight: 600; padding: 0 6px; min-width: 20px; text-align: center;">{{ item.quantity }}</span>
                    <button type="button" class="cart-qty-btn" data-change="1" data-key="{{ item.key }}" data-qty="{{ item.quantity }}" style="background: none; border: none; padding: 4px 10px; cursor: pointer; font-size: 14px; color: var(--color-ink);" aria-label="Increase quantity">+</button>
                  </div>
                  <div style="font-weight: 600; font-size: 13.5px; color: var(--color-ink);">{{ item.line_price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip }}</div>
                </div>
              </div>
              <button type="button" class="cart-item-remove" data-key="{{ item.key }}" title="Remove item" aria-label="Remove {{ item.title }}" style="background: none; border: none; color: var(--color-muted); cursor: pointer; font-size: 20px; line-height: 1; padding: 0 4px; margin-left: 4px;">&times;</button>
            </div>
          {% endfor %}
        {% endif %}
      </div>

      <div class="cart-drawer-footer" id="cart-drawer-footer" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
        <div style="display: flex; justify-content: space-between; font-size: 16px; font-weight: 600; margin-bottom: 16px;">
          <span>Subtotal</span>
          <span class="cart-drawer-subtotal">{{ cart.total_price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip }}</span>
        </div>
        <p style="font-size: 11.5px; color: var(--color-muted); margin-bottom: 16px;">Taxes calculated at checkout. Free transit-insured delivery across India.</p>
        <a href="/checkout" class="btn btn-primary cart-checkout-btn" style="width: 100%;">
          <span class="desktop-checkout-text">Proceed to Secure Checkout &rarr;</span>
          <span class="mobile-checkout-text">Checkout &rarr;</span>
        </a>
      </div>
    </aside>

    <!-- JS -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
