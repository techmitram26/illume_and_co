{% comment %}
  Interactive Light Switch Snippet (axnine & incommonwith style)
  Lets customer toggle fixture illumination state (ON vs OFF)
{% endcomment %}

<div class="light-switch-control" role="group" aria-label="Fixture Illumination Control">
  <button type="button" class="light-switch-btn active" data-light-toggle="off" aria-pressed="true">
    <span class="light-bulb-indicator"></span>
    <span>Light OFF</span>
  </button>
  <button type="button" class="light-switch-btn" data-light-toggle="on" aria-pressed="false">
    <span class="light-bulb-indicator"></span>
    <span>Light ON ✦</span>
  </button>
</div>
