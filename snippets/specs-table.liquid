{% comment %}
  Technical Specifications Table for Ambika Lights PDP
  Renders either metafield data or sensible default architectural lighting specs
{% endcomment %}

<table class="specs-table" style="width: 100%; border-collapse: collapse; font-size: 13px;">
  <tbody>
    <tr style="border-bottom: 1px solid var(--color-border);">
      <td style="font-weight: 500; padding: 10px 0; width: 42%; color: #8A8175;">Product Category</td>
      <td style="padding: 10px 0; font-weight: 600; color: #292929;">{{ product.type | default: 'Decorative Chandelier' }}</td>
    </tr>
    <tr style="border-bottom: 1px solid var(--color-border);">
      <td style="font-weight: 500; padding: 10px 0; width: 42%; color: #8A8175;">Primary Material &amp; Finish</td>
      <td style="padding: 10px 0; font-weight: 600; color: #292929;">{{ product.metafields.custom.finish | default: 'Precision Brass Frame & Handcrafted Optical Crystal' }}</td>
    </tr>
    <tr style="border-bottom: 1px solid var(--color-border);">
      <td style="font-weight: 500; padding: 10px 0; width: 42%; color: #8A8175;">Wattage / Consumption</td>
      <td style="padding: 10px 0; font-weight: 600; color: #292929;">{{ product.metafields.custom.wattage | default: 'High-Efficiency Architectural LED' }}</td>
    </tr>
    <tr style="border-bottom: 1px solid var(--color-border);">
      <td style="font-weight: 500; padding: 10px 0; width: 42%; color: #8A8175;">Color Temperature (CCT)</td>
      <td style="padding: 10px 0; font-weight: 600; color: #292929;">{{ product.metafields.custom.color_temperature | default: '3000K Warm White (Atmospheric Illumination)' }}</td>
    </tr>
    <tr style="border-bottom: 1px solid var(--color-border);">
      <td style="font-weight: 500; padding: 10px 0; width: 42%; color: #8A8175;">Operating Voltage</td>
      <td style="padding: 10px 0; font-weight: 600; color: #292929;">220V - 240V AC, 50Hz (Indian Standard)</td>
    </tr>
    <tr style="border-bottom: 1px solid var(--color-border);">
      <td style="font-weight: 500; padding: 10px 0; width: 42%; color: #8A8175;">Recommended Placement</td>
      <td style="padding: 10px 0; font-weight: 600; color: #292929;">Living Salons, Dining Galleries, Foyers</td>
    </tr>
    <tr style="border-bottom: 1px solid var(--color-border);">
      <td style="font-weight: 500; padding: 10px 0; width: 42%; color: #8A8175;">HSN Code (GST)</td>
      <td style="padding: 10px 0; font-weight: 600; color: #292929;">9405</td>
    </tr>
    <tr>
      <td style="font-weight: 500; padding: 10px 0; width: 42%; color: #8A8175;">Warranty Protection</td>
      <td style="padding: 10px 0; font-weight: 600; color: #292929;">2 Years Comprehensive Fixture Coverage</td>
    </tr>
  </tbody>
</table>
