{%- comment -%}
  Ambika Lights Collection Listing (main-collection.liquid) with Dynamic Fail-Safe Filter URLs
{%- endcomment -%}

{%- assign chandeliers_url = '/collections/all?filter.p.product_type=Chandeliers' -%}
{%- if collections['chandeliers'] != blank and collections['chandeliers'].url != blank -%}
  {%- assign chandeliers_url = collections['chandeliers'].url -%}
{%- endif -%}

{%- assign pendants_url = '/collections/all?filter.p.product_type=Pendant+Lights' -%}
{%- if collections['pendants'] != blank and collections['pendants'].url != blank -%}
  {%- assign pendants_url = collections['pendants'].url -%}
{%- elsif collections['pendant-lights'] != blank and collections['pendant-lights'].url != blank -%}
  {%- assign pendants_url = collections['pendant-lights'].url -%}
{%- endif -%}

{%- assign wall_lights_url = '/collections/all?filter.p.product_type=Wall+Lights' -%}
{%- if collections['wall-lights'] != blank and collections['wall-lights'].url != blank -%}
  {%- assign wall_lights_url = collections['wall-lights'].url -%}
{%- elsif collections['wall-lights-sconces'] != blank and collections['wall-lights-sconces'].url != blank -%}
  {%- assign wall_lights_url = collections['wall-lights-sconces'].url -%}
{%- endif -%}

{%- assign ceiling_lights_url = '/collections/all?filter.p.product_type=Ceiling+Lights' -%}
{%- if collections['ceiling-lights'] != blank and collections['ceiling-lights'].url != blank -%}
  {%- assign ceiling_lights_url = collections['ceiling-lights'].url -%}
{%- endif -%}

<section class="section" style="padding: 40px 0 90px;">
  <div class="container">
    <!-- Breadcrumb & Header -->
    <div style="margin-bottom: 30px;">
      <span class="eyebrow">Artisanal Luminaires &bull; {{ collection.title | default: 'Complete Collection' }}</span>
      <h1 class="section-title" style="margin-bottom: 10px;">{{ collection.title | default: 'All Luxury Lighting' }}</h1>
      {% if collection.description != blank %}
        <p style="color: var(--color-muted); max-width: 700px; font-size: 14.5px;">{{ collection.description }}</p>
      {% endif %}
    </div>

    <!-- Active Filters & Sorting Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); margin-bottom: 30px; flex-wrap: wrap; gap: 14px;">
      <div style="display: flex; gap: 16px; font-size: 13px; color: var(--color-muted); flex-wrap: wrap; align-items: center;">
        <span style="font-weight: 600; color: var(--color-ink);">Category:</span>
        <a href="/collections/all" style="color: var(--color-primary); font-weight: 500;">All Fixtures</a>
        <a href="{{ chandeliers_url }}">Chandeliers</a>
        <a href="{{ pendants_url }}">Pendants</a>
        <a href="{{ wall_lights_url }}">Wall Lights</a>
        <a href="{{ ceiling_lights_url }}">Ceiling Lights</a>
      </div>

      <div>
        <select style="padding: 6px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 12.5px; background: #FFF;">
          <option>Sort by: Featured</option>
          <option>Price: Low to High</option>
          <option>Price: High to Low</option>
          <option>Newest Arrivals</option>
        </select>
      </div>
    </div>

    <!-- Products Grid -->
    {% paginate collection.products by 24 %}
      <div class="product-grid">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px;">
            <p style="font-size: 16px; color: var(--color-muted); margin-bottom: 24px;">No fixtures found in this collection yet.</p>
            <a href="/collections/all" class="btn btn-primary" style="padding: 12px 28px;">Browse All Fixtures</a>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="text-center" style="margin-top: 50px;">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
