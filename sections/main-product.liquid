{% comment %}
  Ambika Lights Luxury PDP Section (main-product.liquid)
  Features:
  - Interactive Light Switch (ON / OFF illumination state preview)
  - Color Temperature (CCT) Kelvin Selector
  - Indian Pincode Delivery & Pune Showroom Installation Checker
  - Technical Lighting Engineering Specs Table
  - WhatsApp Direct Concierge Button
{% endcomment %}

<section class="section" style="padding: 50px 0 90px;">
  <div class="container">
    <div class="pdp-layout-grid">
      
      <!-- LEFT COLUMN: INTERACTIVE GALLERY & LIGHT TOGGLE -->
      <div class="pdp-gallery-wrapper">
        <!-- Light ON/OFF Switch -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
          {% render 'light-toggle' %}
          <span style="font-size: 11.5px; color: var(--color-muted); letter-spacing: 0.05em;">Click to view fixture illuminated</span>
        </div>

        <!-- Vertical Gallery Layout: Multi-Image Thumbnails on Left, Main Preview on Right -->
        <div class="pdp-gallery-grid">
          <!-- Vertical Thumbnails Column -->
          <div class="pdp-thumbnails-vertical" aria-label="Product Media Gallery">
            {% if product.media.size > 1 %}
              {% for media in product.media %}
                <div 
                  class="pdp-thumb {% if forloop.first %}active{% endif %}" 
                  data-index="{{ forloop.index0 }}"
                  data-full-src="{{ media.preview_image | image_url: width: 1000 }}"
                  tabindex="0"
                  role="button"
                  aria-label="{{ product.title }} image {{ forloop.index }}"
                >
                  <img src="{{ media.preview_image | image_url: width: 180 }}" alt="{{ product.title }} view {{ forloop.index }}" width="80" height="92" loading="lazy">
                </div>
              {% endfor %}
            {% else %}
              <div class="pdp-thumb active" data-index="0" data-full-src="{{ main_off_src }}" tabindex="0" role="button">
                <img src="{{ main_off_src }}" alt="{{ product.title }} Studio" width="80" height="92" loading="lazy">
              </div>
              {% if main_on_src != main_off_src %}
                <div class="pdp-thumb" data-index="1" data-full-src="{{ main_on_src }}" tabindex="0" role="button">
                  <img src="{{ main_on_src }}" alt="{{ product.title }} Illuminated" width="80" height="92" loading="lazy">
                </div>
              {% endif %}
            {% endif %}
          </div>

          <!-- Main Product Gallery Box -->
          <div class="product-hero-gallery" id="pdp-gallery-box">
            {%- assign default_off_img = 'Il_CH_005_01_White_Background.jpg' | asset_url -%}
            {%- assign default_on_img = 'Il_CH_005_02_Use_Case.jpg' | asset_url -%}
            {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
            {%- assign secondary_media = product.media[1] -%}
            
            {%- if featured_media.preview_image -%}
              {%- assign main_off_src = featured_media.preview_image | image_url: width: 1000 -%}
              {%- assign main_on_src = secondary_media.preview_image | default: featured_media.preview_image | image_url: width: 1000 -%}
            {%- else -%}
              {%- assign main_off_src = default_off_img -%}
              {%- assign main_on_src = default_on_img -%}
            {%- endif -%}

            <img 
              src="{{ main_off_src }}" 
              data-light-off-src="{{ main_off_src }}"
              data-light-on-src="{{ main_on_src }}"
              alt="{{ product.title | default: 'Crystal Loop Drop Chandelier' | escape }}" 
              width="1000"
              height="1000"
              class="pdp-main-image"
              id="pdp-main-img"
              style="width: 100%; height: auto; max-height: 580px; object-fit: contain; margin: 0 auto; transition: opacity 0.2s ease;"
            >
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: PRODUCT INFO & PURCHASE CONTROLS -->
      <div>
        <span class="eyebrow">{{ product.type | default: 'Decorative Chandelier' }}</span>
        <h1 class="pdp-title">{{ product.title | default: 'Faceted Crystal Halo Chandelier' }}</h1>

        <!-- Price -->
        <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 24px;">
          <span style="font-size: 26px; font-weight: 600; color: var(--color-ink);" class="pdp-price">
            {{ product.selected_or_first_available_variant.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip | default: '₹24,900' }}
          </span>
          {% if product.compare_at_price > product.price %}
            <span style="font-size: 16px; text-decoration: line-through; color: var(--color-muted);" class="pdp-compare-price">
              {{ product.compare_at_price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip }}
            </span>
            <span style="background: var(--color-primary-light); color: var(--color-primary-hover); font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 2px;">
              Special Value
            </span>
          {% endif %}
        </div>

        {%- comment -%}
          Separate editorial prose description from embedded specs table
        {%- endcomment -%}
        {%- assign pdp_editorial = '' -%}
        {%- assign pdp_specs_block = '' -%}
        {%- if product.description contains '<div class="product-specs-wrapper"' -%}
          {%- assign desc_splits = product.description | split: '<div class="product-specs-wrapper"' -%}
          {%- assign pdp_editorial = desc_splits[0] -%}
          {%- assign pdp_specs_block = '<div class="product-specs-wrapper"' | append: desc_splits[1] -%}
        {%- else -%}
          {%- assign pdp_editorial = product.description -%}
        {%- endif -%}

        <div style="color: #4A443D; font-size: 14.5px; line-height: 1.75; margin-bottom: 24px;" class="pdp-narrative-desc">
          {%- if pdp_editorial != blank -%}
            {{ pdp_editorial }}
          {%- else -%}
            <p>A statement artisanal luminaire crafted with meticulous metalwork and hand-cut crystalline details. Engineered for warm architectural ambiance with glare-free diffusion across luxury living, dining, and reception interiors.</p>
          {%- endif -%}
        </div>

        <!-- Product Form -->
        <form method="post" action="/cart/add" id="pdp-form">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          {%- comment -%}
            Color Temperature (CCT) Display Logic:
            - Only show 3-Card Interactive Selector if product actually supports switchable CCT (from Excel)
            - Show single badge if fixed Warm White or Neutral White
            - Hide completely if no CCT specified
          {%- endcomment -%}
          {%- assign cct_mode = 'none' -%}
          {%- for tag in product.tags -%}
            {%- assign down_tag = tag | downcase -%}
            {%- if down_tag contains '3 in 1' or down_tag contains '3iin 1' or down_tag contains '3-in-1' or down_tag contains 'tri-color' -%}
              {%- assign cct_mode = '3in1' -%}
            {%- elsif down_tag contains 'warm white' -%}
              {%- if cct_mode == 'none' -%}{%- assign cct_mode = 'warm' -%}{%- endif -%}
            {%- elsif down_tag contains 'neutral white' or down_tag contains 'natural white' -%}
              {%- if cct_mode == 'none' -%}{%- assign cct_mode = 'neutral' -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if cct_mode == '3in1' -%}
            <!-- CCT Light Temperature Selector (3-in-1 Switchable) -->
            <div class="cct-selector">
              <div class="cct-label">
                <span>Light Temperature (CCT)</span>
                <span class="text-gold" data-selected-cct>3000K Warm White</span>
              </div>
              <div class="cct-options-grid">
                <div class="cct-option-card selected" data-kelvin="3000K Warm White">
                  <span class="cct-temp-kelvin">3000K</span>
                  <span class="cct-temp-name">Warm Amber</span>
                </div>
                <div class="cct-option-card" data-kelvin="4000K Neutral White">
                  <span class="cct-temp-kelvin">4000K</span>
                  <span class="cct-temp-name">Daylight Neutral</span>
                </div>
                <div class="cct-option-card" data-kelvin="6000K Cool White">
                  <span class="cct-temp-kelvin">6000K</span>
                  <span class="cct-temp-name">Crisp Architectural</span>
                </div>
              </div>
              <input type="hidden" name="properties[Light Temperature]" value="3000K Warm White">
            </div>
          {%- elsif cct_mode == 'warm' -%}
            <div style="margin: 20px 0; padding: 12px 18px; background: #FAF7F2; border: 1px solid var(--color-border); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: space-between;">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted);">Light Temperature</span>
              <span style="font-size: 13px; font-weight: 600; color: var(--color-ink);">3000K Warm White (Fixed Ambient)</span>
            </div>
          {%- elsif cct_mode == 'neutral' -%}
            <div style="margin: 20px 0; padding: 12px 18px; background: #FAF7F2; border: 1px solid var(--color-border); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: space-between;">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-muted);">Light Temperature</span>
              <span style="font-size: 13px; font-weight: 600; color: var(--color-ink);">4000K Neutral White (Fixed Daylight)</span>
            </div>
          {%- endif -%}

          <!-- Action Buttons -->
          <div style="display: flex; gap: 14px; margin-top: 28px;">
            <button type="submit" class="btn btn-primary pdp-buy-button" style="flex: 1.3; padding: 16px 20px;">
              Add to Bag &bull; {{ product.selected_or_first_available_variant.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip | default: '₹24,900' }}
            </button>
            <a 
              href="https://wa.me/{{ settings.store_whatsapp | default: '918983404458' }}?text=Hello%20Illume%20%26%20Co,%20I%20am%20interested%20in%20{{ product.title | url_encode }}%20({{ shop.url }}{{ product.url }}).%20Please%20share%20availability%20and%20finish%20details." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-dark" 
              style="flex: 1; padding: 16px 14px;"
            >
              {% render 'icon', name: 'whatsapp' %}
              <span>Enquire</span>
            </a>
          </div>
        </form>

        <!-- Indian Pincode Checker -->
        {% render 'pincode-checker' %}

        <!-- Trust Badges -->
        <div class="trust-badges-bar">
          <div class="trust-badge-item">
            {% render 'icon', name: 'shield' %}
            <strong>100% Fragile Guarantee</strong>
            <span>Safe transit crate packing</span>
          </div>
          <div class="trust-badge-item">
            {% render 'icon', name: 'truck' %}
            <strong>Insured Pan-India Shipping</strong>
            <span>Doorstep tracked delivery</span>
          </div>
          <div class="trust-badge-item">
            {% render 'icon', name: 'pin' %}
            <strong>Pune Showroom Support</strong>
            <span>Live demo & installation</span>
          </div>
        </div>

        <!-- Technical Specs & Accordions (Single Open Mode to prevent whitespace) -->
        <div class="pdp-accordions-group" data-accordion-group style="margin-top: 28px;">
          <!-- Accordion 1: Technical Specs -->
          <div class="accordion-item" style="border-bottom: 1px solid var(--color-border);">
            <button type="button" class="accordion-trigger active" aria-expanded="true" style="width: 100%; text-align: left; background: none; border: none; padding: 18px 0; font-family: var(--font-sans); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; display: flex; justify-content: space-between; align-items: center; cursor: pointer; color: var(--color-ink);">
              <span>Technical Lighting Specifications</span>
              <span class="accordion-icon" style="font-size: 17px; font-weight: 400; line-height: 1;">&minus;</span>
            </button>
            <div class="accordion-panel" style="padding-bottom: 20px; display: block;">
              {% if pdp_specs_block != blank %}
                {{ pdp_specs_block }}
              {% else %}
                {% render 'specs-table' %}
              {% endif %}
            </div>
          </div>

          <!-- Accordion 2: Dimensions & Drop Height -->
          <div class="accordion-item" style="border-bottom: 1px solid var(--color-border);">
            <button type="button" class="accordion-trigger" aria-expanded="false" style="width: 100%; text-align: left; background: none; border: none; padding: 18px 0; font-family: var(--font-sans); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; display: flex; justify-content: space-between; align-items: center; cursor: pointer; color: var(--color-ink);">
              <span>Dimensions &amp; Ceiling Suspension</span>
              <span class="accordion-icon" style="font-size: 17px; font-weight: 400; line-height: 1;">&plus;</span>
            </button>
            <div class="accordion-panel" style="padding-bottom: 20px; display: none;">
              <p style="font-size: 13px; color: var(--color-muted); line-height: 1.6; margin: 0;">
                Standard package includes an adjustable steel suspension wire kit allowing total drop heights from 500mm up to 2500mm. Custom suspension rods for double-height ceilings (up to 20 feet) are available upon request through our Pune showroom team.
              </p>
            </div>
          </div>

          <!-- Accordion 3: Safe Packaging & Return Policy -->
          <div class="accordion-item" style="border-bottom: 1px solid var(--color-border);">
            <button type="button" class="accordion-trigger" aria-expanded="false" style="width: 100%; text-align: left; background: none; border: none; padding: 18px 0; font-family: var(--font-sans); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; display: flex; justify-content: space-between; align-items: center; cursor: pointer; color: var(--color-ink);">
              <span>Transit Protection &amp; Breakage Guarantee</span>
              <span class="accordion-icon" style="font-size: 17px; font-weight: 400; line-height: 1;">&plus;</span>
            </button>
            <div class="accordion-panel" style="padding-bottom: 20px; display: none;">
              <p style="font-size: 13px; color: var(--color-muted); line-height: 1.6; margin: 0;">
                Every fixture is cushioned in multi-density custom foam and dispatched in reinforced wooden crates. In the rare event of transit damage, notify us within 48 hours for immediate replacement parts or complete unit replacement at no extra cost.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- STICKY BOTTOM BAR FOR MOBILE CONVERSION -->
<div class="sticky-pdp-bar" style="position: fixed; bottom: 0; left: 0; right: 0; background: #FFF; border-top: 1px solid var(--color-border); padding: 12px 20px; z-index: 90; display: none; box-shadow: 0 -4px 20px rgba(0,0,0,0.08);">
  <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
      <div style="font-weight: 600; font-size: 15px;">{{ product.title | default: 'Faceted Crystal Halo Chandelier' }}</div>
      <div style="font-size: 14px; color: var(--color-primary); font-weight: 600;" class="sticky-bar-price">{{ product.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip | default: '₹24,900' }}</div>
    </div>
    <button type="button" class="btn btn-primary" style="padding: 10px 24px; font-size: 11px;" onclick="document.getElementById('pdp-form').submit();">
      Add to Bag
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Main Product Detail",
  "settings": []
}
{% endschema %}
