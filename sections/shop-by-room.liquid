{%- comment -%}
  Illume & Co / Ambika Lights - "Curated for the Room" Expanding Spatial Showcase
  - 6 horizontal expanding room tiles with interactive hover & click extension
  - Real-time synchronized bottom product showcase with room-specific narrative & curated fixtures
  - Indian Rupee currency format (₹)
{%- endcomment -%}

{%- assign all_spaces_url = section.settings.all_spaces_link | default: routes.all_products_collection_url -%}
{%- assign col_bedroom = section.settings.collection_bedroom -%}
{%- if col_bedroom.title == blank and section.settings.collection_bedroom != blank -%}
  {%- assign col_bedroom = collections[section.settings.collection_bedroom] -%}
{%- endif -%}
{%- assign col_dining = section.settings.collection_dining -%}
{%- if col_dining.title == blank and section.settings.collection_dining != blank -%}
  {%- assign col_dining = collections[section.settings.collection_dining] -%}
{%- endif -%}
{%- assign col_living = section.settings.collection_living -%}
{%- if col_living.title == blank and section.settings.collection_living != blank -%}
  {%- assign col_living = collections[section.settings.collection_living] -%}
{%- endif -%}
{%- assign col_kitchen = section.settings.collection_kitchen -%}
{%- if col_kitchen.title == blank and section.settings.collection_kitchen != blank -%}
  {%- assign col_kitchen = collections[section.settings.collection_kitchen] -%}
{%- endif -%}
{%- assign col_staircase = section.settings.collection_staircase -%}
{%- if col_staircase.title == blank and section.settings.collection_staircase != blank -%}
  {%- assign col_staircase = collections[section.settings.collection_staircase] -%}
{%- endif -%}
{%- assign col_vanity = section.settings.collection_vanity -%}
{%- if col_vanity.title == blank and section.settings.collection_vanity != blank -%}
  {%- assign col_vanity = collections[section.settings.collection_vanity] -%}
{%- endif -%}

<section class="section curated-room-section" id="curated-rooms" style="background-color: #0E0D0C; color: #FFFFFF; padding: 90px 0; overflow: hidden;">
  <div class="container">
    
    <!-- Section Header -->
    <div class="curated-room-header" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 36px; flex-wrap: wrap; gap: 20px;">
      <div>
        <span class="curated-room-eyebrow" style="display: inline-block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: #C5A880; margin-bottom: 10px;">
          {{ section.settings.eyebrow | default: '✦ Shop by Space — Curated Collections' }}
        </span>
        <h2 class="curated-room-title" style="font-family: var(--font-serif, 'Playfair Display', Georgia, serif); font-size: clamp(32px, 4.5vw, 48px); font-weight: 400; color: #FFFFFF; margin: 0 0 10px; line-height: 1.15; letter-spacing: -0.01em;">
          {{ section.settings.title | default: 'Curated for the Room' }}
        </h2>
        <p class="curated-room-subtitle" style="font-size: 14.5px; color: #A8A196; margin: 0; max-width: 620px; line-height: 1.6;">
          {{ section.settings.subtitle | default: 'Six spaces where light matters most — from bedside intimacy to entryway impressions.' }}
        </p>
      </div>

      <div>
        <a href="{{ all_spaces_url }}" class="curated-room-all-link" style="color: #FFFFFF; font-size: 13.5px; font-weight: 500; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.4); padding-bottom: 4px; display: inline-flex; align-items: center; gap: 6px; transition: border-color 0.2s ease, color 0.2s ease;">
          <span>{{ section.settings.all_spaces_text | default: 'Shop all spaces' }}</span>
          <span style="font-size: 14px;">&#8599;</span>
        </a>
      </div>
    </div>

    <!-- 6 Expanding Horizontal Accordion Tiles -->
    <div class="curated-room-tiles-strip" role="tablist" aria-label="Curated Room Collections">
      
      <!-- 1. Bedroom (Default Active) -->
      <div 
        class="room-tile is-active" 
        data-room="bedroom"
        role="tab"
        aria-selected="true"
        aria-controls="panel-bedroom"
        tabindex="0"
      >
        <img 
          src="{{ 'Il_CH_005_03_Wide_Use_Case.jpg' | asset_url }}" 
          alt="Curated Lighting for Bedroom" 
          class="room-tile-bg"
          loading="lazy"
          width="900"
          height="600"
        >
        <div class="room-tile-overlay"></div>
        <div class="room-tile-badge-circle">
          <span>UP TO</span>
          <strong>30%</strong>
          <span>OFF</span>
        </div>

        <!-- Collapsed vertical title -->
        <div class="room-tile-collapsed-label">Bedroom</div>

        <!-- Expanded content overlay -->
        <div class="room-tile-expanded-content">
          <span class="room-tile-tag">Curated Pick</span>
          <h3 class="room-tile-heading">Bedroom</h3>
          <a href="{{ col_bedroom.url | default: all_spaces_url }}" class="btn room-tile-btn">Shop &rarr;</a>
        </div>
      </div>

      <!-- 2. Dining Room -->
      <div 
        class="room-tile" 
        data-room="dining"
        role="tab"
        aria-selected="false"
        aria-controls="panel-dining"
        tabindex="0"
      >
        <img 
          src="{{ 'Il_CH_002_03_Wide_Use_Case.jpg' | asset_url }}" 
          alt="Curated Lighting for Dining Room" 
          class="room-tile-bg"
          loading="lazy"
          width="900"
          height="600"
        >
        <div class="room-tile-overlay"></div>
        <div class="room-tile-badge-circle">
          <span>UP TO</span>
          <strong>30%</strong>
          <span>OFF</span>
        </div>

        <div class="room-tile-collapsed-label">Dining Room</div>

        <div class="room-tile-expanded-content">
          <span class="room-tile-tag">Curated Pick</span>
          <h3 class="room-tile-heading">Dining Room</h3>
          <a href="{{ col_dining.url | default: all_spaces_url }}" class="btn room-tile-btn">Shop &rarr;</a>
        </div>
      </div>

      <!-- 3. Living Room -->
      <div 
        class="room-tile" 
        data-room="living"
        role="tab"
        aria-selected="false"
        aria-controls="panel-living"
        tabindex="0"
      >
        <img 
          src="{{ 'Il_CH_001_03_Wide_Use_Case.jpg' | asset_url }}" 
          alt="Curated Lighting for Living Room" 
          class="room-tile-bg"
          loading="lazy"
          width="900"
          height="600"
        >
        <div class="room-tile-overlay"></div>
        <div class="room-tile-badge-circle">
          <span>UP TO</span>
          <strong>30%</strong>
          <span>OFF</span>
        </div>

        <div class="room-tile-collapsed-label">Living Room</div>

        <div class="room-tile-expanded-content">
          <span class="room-tile-tag">Curated Pick</span>
          <h3 class="room-tile-heading">Living Room</h3>
          <a href="{{ col_living.url | default: all_spaces_url }}" class="btn room-tile-btn">Shop &rarr;</a>
        </div>
      </div>

      <!-- 4. Kitchen Island -->
      <div 
        class="room-tile" 
        data-room="kitchen"
        role="tab"
        aria-selected="false"
        aria-controls="panel-kitchen"
        tabindex="0"
      >
        <img 
          src="{{ 'Il_PL_001_02_Use_Case.jpg' | asset_url }}" 
          alt="Curated Lighting for Kitchen Island" 
          class="room-tile-bg"
          loading="lazy"
          width="900"
          height="600"
        >
        <div class="room-tile-overlay"></div>
        <div class="room-tile-badge-circle">
          <span>UP TO</span>
          <strong>30%</strong>
          <span>OFF</span>
        </div>

        <div class="room-tile-collapsed-label">Kitchen Island</div>

        <div class="room-tile-expanded-content">
          <span class="room-tile-tag">Curated Pick</span>
          <h3 class="room-tile-heading">Kitchen Island</h3>
          <a href="{{ col_kitchen.url | default: all_spaces_url }}" class="btn room-tile-btn">Shop &rarr;</a>
        </div>
      </div>

      <!-- 5. Staircase & Entryway -->
      <div 
        class="room-tile" 
        data-room="staircase"
        role="tab"
        aria-selected="false"
        aria-controls="panel-staircase"
        tabindex="0"
      >
        <img 
          src="{{ 'Il_CH_012_03_Wide_Use_Case.jpg' | asset_url }}" 
          alt="Curated Lighting for Staircase and Entryway" 
          class="room-tile-bg"
          loading="lazy"
          width="900"
          height="600"
        >
        <div class="room-tile-overlay"></div>
        <div class="room-tile-badge-circle">
          <span>UP TO</span>
          <strong>30%</strong>
          <span>OFF</span>
        </div>

        <div class="room-tile-collapsed-label">Staircase &amp; Entryway</div>

        <div class="room-tile-expanded-content">
          <span class="room-tile-tag">Curated Pick</span>
          <h3 class="room-tile-heading">Staircase &amp; Entryway</h3>
          <a href="{{ col_staircase.url | default: all_spaces_url }}" class="btn room-tile-btn">Shop &rarr;</a>
        </div>
      </div>

      <!-- 6. Vanity & Bathroom -->
      <div 
        class="room-tile" 
        data-room="vanity"
        role="tab"
        aria-selected="false"
        aria-controls="panel-vanity"
        tabindex="0"
      >
        <img 
          src="{{ 'Il_WL_006_03_Wide_Use_Case.jpg' | asset_url }}" 
          alt="Curated Lighting for Vanity and Bathroom" 
          class="room-tile-bg"
          loading="lazy"
          width="900"
          height="600"
        >
        <div class="room-tile-overlay"></div>
        <div class="room-tile-badge-circle">
          <span>UP TO</span>
          <strong>30%</strong>
          <span>OFF</span>
        </div>

        <div class="room-tile-collapsed-label">Vanity &amp; Bathroom</div>

        <div class="room-tile-expanded-content">
          <span class="room-tile-tag">Curated Pick</span>
          <h3 class="room-tile-heading">Vanity &amp; Bathroom</h3>
          <a href="{{ col_vanity.url | default: all_spaces_url }}" class="btn room-tile-btn">Shop &rarr;</a>
        </div>
      </div>

    </div>

    <!-- Synchronized Bottom Products Showcase Container -->
    <div class="curated-room-showcase-container" style="margin-top: 50px;">
      
      <!-- Panel 1: Bedroom -->
      <div class="room-showcase-panel is-active" id="panel-bedroom" data-room-panel="bedroom" role="tabpanel">
        <div class="room-showcase-grid">
          <!-- Left Editorial Details -->
          <div class="room-editorial-col">
            <h3 class="room-editorial-title">Shop the Bedroom</h3>
            <p class="room-editorial-desc">
              Soft, low light for winding down &mdash; thoughtful fixtures engineered for restful rooms and warm evening ambiance.
            </p>
            <div class="room-pills-filter">
              <a href="{{ all_spaces_url }}?filter.p.product_type=Chandeliers" class="room-sub-pill">Crystal Chandeliers</a>
              <a href="{{ all_spaces_url }}?filter.p.product_type=Pendant+Lights" class="room-sub-pill">Bedside Pendants</a>
              <a href="{{ all_spaces_url }}?filter.p.product_type=Wall+Lights" class="room-sub-pill">Reading Sconces</a>
            </div>
            <a href="{{ col_bedroom.url | default: all_spaces_url }}" class="room-explore-link">
              <span>Shop Bedroom Fixtures</span>
              <span>&rarr;</span>
            </a>
          </div>

          <!-- Right 3 Curated Products -->
          <div class="room-products-grid">
            {%- if col_bedroom != blank and col_bedroom.products.size > 0 -%}
              {%- for prod in col_bedroom.products limit: 3 -%}
                <div class="room-product-card">
                  <div class="room-product-media">
                    <a href="{{ prod.url }}">
                      {%- if prod.featured_image -%}
                        <img src="{{ prod.featured_image | image_url: width: 450 }}" alt="{{ prod.title | escape }}" width="400" height="400" loading="lazy">
                      {%- else -%}
                        <img src="{{ 'Il_CH_005_01_White_Background.jpg' | asset_url }}" alt="{{ prod.title | escape }}" width="400" height="400" loading="lazy">
                      {%- endif -%}
                    </a>
                    <div class="room-tag-pendant"><span>UP TO</span><strong>30%</strong><span>OFF</span></div>
                  </div>
                  <div class="room-product-info">
                    <div class="room-product-sku">{% if prod.selected_or_first_available_variant.sku != blank %}SKU {{ prod.selected_or_first_available_variant.sku }}{% else %}{{ prod.type | default: 'Illume & Co' }}{% endif %} &bull; Bedroom</div>
                    <h4 class="room-product-name"><a href="{{ prod.url }}">{{ prod.title }}</a></h4>
                    <div class="room-product-price">{{ prod.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip }}</div>
                  </div>
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- assign b_p1 = all_products['champagne-crystal-halo-chandelier-il_ch_005'] -%}
            {%- assign b_fb1 = 'Il_CH_005_01_White_Background.jpg' | asset_url -%}
            <div class="room-product-card">
              <div class="room-product-media">
                <a href="{{ b_p1.url | default: '/products/champagne-crystal-halo-chandelier-il_ch_005' }}">
                  <img src="{{ b_p1.featured_image | image_url: width: 450 | default: b_fb1 }}" alt="Champagne Crystal Halo Chandelier" width="400" height="400" loading="lazy">
                </a>
                <div class="room-tag-pendant"><span>UP TO</span><strong>30%</strong><span>OFF</span></div>
              </div>
              <div class="room-product-info">
                <div class="room-product-sku">SKU Il_CH_005 &bull; Bedroom</div>
                <h4 class="room-product-name"><a href="{{ b_p1.url | default: '/products/champagne-crystal-halo-chandelier-il_ch_005' }}">{{ b_p1.title | default: 'Champagne Crystal Halo Chandelier' }}</a></h4>
                <div class="room-product-price">{{ b_p1.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip | default: '₹14,500' }}</div>
              </div>
            </div>

            {%- assign b_p2 = all_products['amber-bowl-pendant-il_pl_001'] -%}
            {%- assign b_fb2 = 'Il_PL_001_01_White_Background.jpg' | asset_url -%}
            <div class="room-product-card">
              <div class="room-product-media">
                <a href="{{ b_p2.url | default: '/products/amber-bowl-pendant-il_pl_001' }}">
                  <img src="{{ b_p2.featured_image | image_url: width: 450 | default: b_fb2 }}" alt="Amber Bowl Bedside Pendant" width="400" height="400" loading="lazy">
                </a>
                <div class="room-tag-pendant"><span>UP TO</span><strong>30%</strong><span>OFF</span></div>
              </div>
              <div class="room-product-info">
                <div class="room-product-sku">SKU Il_PL_001 &bull; Bedroom</div>
                <h4 class="room-product-name"><a href="{{ b_p2.url | default: '/products/amber-bowl-pendant-il_pl_001' }}">{{ b_p2.title | default: 'Amber Bowl Bedside Pendant' }}</a></h4>
                <div class="room-product-price">{{ b_p2.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip | default: '₹4,000' }}</div>
              </div>
            </div>

            {%- assign b_p3 = all_products['minimalist-wall-sconce-il_wl_004'] -%}
            {%- assign b_fb3 = 'Il_WL_004_01_White_Background.jpg' | asset_url -%}
            <div class="room-product-card">
              <div class="room-product-media">
                <a href="{{ b_p3.url | default: '/products/minimalist-wall-sconce-il_wl_004' }}">
                  <img src="{{ b_p3.featured_image | image_url: width: 450 | default: b_fb3 }}" alt="Warm Halo Bedside Sconce" width="400" height="400" loading="lazy">
                </a>
                <div class="room-tag-pendant"><span>UP TO</span><strong>30%</strong><span>OFF</span></div>
              </div>
              <div class="room-product-info">
                <div class="room-product-sku">SKU Il_WL_004 &bull; Bedroom</div>
                <h4 class="room-product-name"><a href="{{ b_p3.url | default: '/products/minimalist-wall-sconce-il_wl_004' }}">{{ b_p3.title | default: 'Warm Halo Bedside Sconce' }}</a></h4>
                <div class="room-product-price">{{ b_p3.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip | default: '₹3,000' }}</div>
              </div>
            </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Panel 2: Dining Room -->
      <div class="room-showcase-panel" id="panel-dining" data-room-panel="dining" role="tabpanel">
        <div class="room-showcase-grid">
          <div class="room-editorial-col">
            <h3 class="room-editorial-title">Shop the Dining Room</h3>
            <p class="room-editorial-desc">
              Statement centerpiece illumination engineered for glare-free dining intimacy, crystal shimmer, and hospitality entertaining.
            </p>
            <div class="room-pills-filter">
              <a href="{{ all_spaces_url }}?filter.p.product_type=Chandeliers" class="room-sub-pill">Linear Chandeliers</a>
              <a href="{{ all_spaces_url }}?filter.p.product_type=Chandeliers" class="room-sub-pill">Crystal Cascades</a>
              <a href="{{ all_spaces_url }}?filter.p.product_type=Pendant+Lights" class="room-sub-pill">Low-Glare Pendants</a>
            </div>
            <a href="{{ col_dining.url | default: all_spaces_url }}" class="room-explore-link">
              <span>Shop Dining Fixtures</span>
              <span>&rarr;</span>
            </a>
          </div>

          <div class="room-products-grid">
            {%- if col_dining != blank and col_dining.products.size > 0 -%}
              {%- for prod in col_dining.products limit: 3 -%}
                <div class="room-product-card">
                  <div class="room-product-media">
                    <a href="{{ prod.url }}">
                      {%- if prod.featured_image -%}
                        <img src="{{ prod.featured_image | image_url: width: 450 }}" alt="{{ prod.title | escape }}" width="400" height="400" loading="lazy">
                      {%- else -%}
                        <img src="{{ 'Il_CH_002_01_White_Background.jpg' | asset_url }}" alt="{{ prod.title | escape }}" width="400" height="400" loading="lazy">
                      {%- endif -%}
                    </a>
                    <div class="room-tag-pendant"><span>UP TO</span><strong>30%</strong><span>OFF</span></div>
                  </div>
                  <div class="room-product-info">
                    <div class="room-product-sku">{% if prod.selected_or_first_available_variant.sku != blank %}SKU {{ prod.selected_or_first_available_variant.sku }}{% else %}{{ prod.type | default: 'Illume & Co' }}{% endif %} &bull; Dining</div>
                    <h4 class="room-product-name"><a href="{{ prod.url }}">{{ prod.title }}</a></h4>
                    <div class="room-product-price">{{ prod.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip }}</div>
                  </div>
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- assign d_p1 = all_products['faceted-crystal-halo-chandelier-il_ch_002'] -%}
            {%- assign d_fb1 = 'Il_CH_002_01_White_Background.jpg' | asset_url -%}
            <div class="room-product-card">
              <div class="room-product-media">
                <a href="{{ d_p1.url | default: '/products/faceted-crystal-halo-chandelier-il_ch_002' }}">
                  <img src="{{ d_p1.featured_image | image_url: width: 450 | default: d_fb1 }}" alt="Faceted Crystal Halo Chandelier" width="400" height="400" loading="lazy">
                </a>
                <div class="room-tag-pendant"><span>UP TO</span><strong>30%</strong><span>OFF</span></div>
              </div>
              <div class="room-product-info">
                <div class="room-product-sku">SKU Il_CH_002 &bull; Dining</div>
                <h4 class="room-product-name"><a href="{{ d_p1.url | default: '/products/faceted-crystal-halo-chandelier-il_ch_002' }}">{{ d_p1.title | default: 'Faceted Crystal Halo Chandelier' }}</a></h4>
                <div class="room-product-price">{{ d_p1.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip | default: '₹7,500' }}</div>
              </div>
            </div>

            {%- assign d_p2 = all_products['golden-petal-pendant-il_pl_002'] -%}
            {%- assign d_fb2 = 'Il_PL_002_01_White_Background.jpg' | asset_url -%}
            <div class="room-product-card">
              <div class="room-product-media">
                <a href="{{ d_p2.url | default: '/products/golden-petal-pendant-il_pl_002' }}">
                  <img src="{{ d_p2.featured_image | image_url: width: 450 | default: d_fb2 }}" alt="Golden Petal Dining Pendant" width="400" height="400" loading="lazy">
                </a>
                <div class="room-tag-pendant"><span>UP TO</span><strong>30%</strong><span>OFF</span></div>
              </div>
              <div class="room-product-info">
                <div class="room-product-sku">SKU Il_PL_002 &bull; Dining</div>
                <h4 class="room-product-name"><a href="{{ d_p2.url | default: '/products/golden-petal-pendant-il_pl_002' }}">{{ d_p2.title | default: 'Golden Petal Dining Pendant' }}</a></h4>
                <div class="room-product-price">{{ d_p2.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip | default: '₹3,500' }}</div>
              </div>
            </div>

            {%- assign d_p3 = all_products['suspended-tiered-crystal-chandelier-il_ch_018'] -%}
            {%- assign d_fb3 = 'Il_CH_018_01_Source_Reference.jpg' | asset_url -%}
            <div class="room-product-card">
              <div class="room-product-media">
                <a href="{{ d_p3.url | default: '/products/suspended-tiered-crystal-chandelier-il_ch_018' }}">
                  <img src="{{ d_p3.featured_image | image_url: width: 450 | default: d_fb3 }}" alt="Suspended Tiered Crystal Chandelier" width="400" height="400" loading="lazy">
                </a>
                <div class="room-tag-pendant"><span>UP TO</span><strong>30%</strong><span>OFF</span></div>
              </div>
              <div class="room-product-info">
                <div class="room-product-sku">SKU Il_CH_018 &bull; Dining</div>
                <h4 class="room-product-name"><a href="{{ d_p3.url | default: '/products/suspended-tiered-crystal-chandelier-il_ch_018' }}">{{ d_p3.title | default: 'Suspended Tiered Crystal Chandelier' }}</a></h4>
                <div class="room-product-price">{{ d_p3.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip | default: '₹15,400' }}</div>
              </div>
            </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Panel 3: Living Room -->
      <div class="room-showcase-panel" id="panel-living" data-room-panel="living" role="tabpanel">
        <div class="room-showcase-grid">
          <div class="room-editorial-col">
            <h3 class="room-editorial-title">Shop the Living Room</h3>
            <p class="room-editorial-desc">
              Multi-layered ambient illumination for expansive salons, soaring ceilings, and relaxed social evenings with layered sconces.
            </p>
            <div class="room-pills-filter">
              <a href="{{ all_spaces_url }}?filter.p.product_type=Chandeliers" class="room-sub-pill">Grand Chandeliers</a>
              <a href="{{ all_spaces_url }}?filter.p.product_type=Wall+Lights" class="room-sub-pill">Perimeter Sconces</a>
