                  <img src="{{ v_p3.featured_image | image_url: width: 450 | default: v_fb3 }}" alt="Architectural Slim Bathroom Sconce" width="400" height="400" loading="lazy">
                </a>
                <div class="room-tag-pendant"><span>UP TO</span><strong>30%</strong><span>OFF</span></div>
              </div>
              <div class="room-product-info">
                <div class="room-product-sku">SKU Il_WL_010 &bull; Vanity</div>
                <h4 class="room-product-name"><a href="{{ v_p3.url | default: '/products/architectural-slim-sconce-il_wl_010' }}">{{ v_p3.title | default: 'Architectural Slim Bathroom Sconce' }}</a></h4>
                <div class="room-product-price">{{ v_p3.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'INR', '' | strip | default: '₹3,700' }}</div>
              </div>
            </div>
            {%- endif -%}
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

