<section class="section" style="padding: 100px 0 60px; text-align: center; background: var(--color-surface, #F3EFE6); border-bottom: 1px solid var(--color-border, #DFD8CC);">
  <div class="container">
    <div style="max-width: 680px; margin: 0 auto;">
      <span class="eyebrow" style="color: var(--color-primary-hover, #B69A70); letter-spacing: 0.15em; font-size: 11.5px; text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 12px;">404 &bull; Page or Collection Not Found</span>
      <h1 class="section-title" style="font-family: var(--font-serif); font-size: 42px; margin-bottom: 18px; color: var(--color-ink, #292929);">The Luminary Piece You Seek Has Moved</h1>
      <p style="color: var(--color-muted, #8A8175); font-size: 15px; line-height: 1.7; margin-bottom: 32px;">
        This specific page or collection is currently being curated in our showroom. Discover our complete master catalogue of artisanal chandeliers, linear pendants, and architectural fixtures below.
      </p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="/collections/all" class="btn btn-primary" style="padding: 14px 28px; font-size: 11.5px; letter-spacing: 0.08em;">Explore Master Catalogue</a>
        <a href="/" class="btn btn-outline-gold" style="padding: 14px 28px; font-size: 11.5px; letter-spacing: 0.08em;">Return to Showroom Home</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 Page Header",
  "settings": []
}
{% endschema %}
