<section class="commercial-banner-section" id="commercial" style="background: #292929 !important; color: #FFFFFF !important; padding: 100px 0; position: relative; border-top: 1px solid #3D3935; border-bottom: 1px solid #3D3935;">
  <div class="container">
    <div class="commercial-grid">
      <!-- Left Column: Narrative & Technical Specifications -->
      <div>
        <div class="cinematic-eyebrow-badge" style="background: rgba(182, 154, 112, 0.14); border-color: rgba(182, 154, 112, 0.35); color: #B69A70;">
          <span class="cinematic-eyebrow-dot" style="background-color: #B69A70;"></span>
          <span>Architectural &amp; Commercial Solutions</span>
        </div>

        <h2 class="commercial-heading" style="font-family: var(--font-serif); font-size: 46px; font-weight: 400; line-height: 1.12; color: #FFFFFF !important; margin: 14px 0 20px;">
          Precision Illumination Engineered for <em style="font-style: italic; color: #B69A70;">Modern Architecture</em>
        </h2>

        <p class="commercial-intro" style="font-size: 15px; line-height: 1.8; color: rgba(255, 255, 255, 0.82) !important; margin-bottom: 32px;">
          From high-end retail boutiques and upscale dining establishments to corporate headquarters and luxury private villas &mdash; Illume &amp; Co supplies precision architectural lighting engineered for high performance, thermal reliability, and zero-glare comfort.
        </p>

        <ul class="commercial-features-list" style="list-style: none !important; padding: 0 !important; margin: 0 0 36px 0 !important; display: flex; flex-direction: column; gap: 20px;">
          <li class="commercial-feature-item" style="list-style: none !important; display: flex !important; align-items: flex-start !important; gap: 16px;">
            <div class="commercial-feature-icon" style="width: 44px; height: 44px; border-radius: 50%; background: rgba(182, 154, 112, 0.14); border: 1px solid rgba(182, 154, 112, 0.35); display: flex; align-items: center; justify-content: center; color: #B69A70; flex-shrink: 0; margin-top: 2px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
            </div>
            <div>
              <strong style="font-size: 15px; font-weight: 600; color: #FFFFFF !important; display: block; margin-bottom: 4px; letter-spacing: 0.02em;">48V Magnetic Track Systems &amp; Modular Drivers</strong>
              <span style="font-size: 13px; color: rgba(255, 255, 255, 0.68) !important; line-height: 1.6; display: block;">Ultra-versatile low-voltage tracks with plug-and-play floodlights, precision accent spots, and pendant drops.</span>
            </div>
          </li>
          
          <li class="commercial-feature-item" style="list-style: none !important; display: flex !important; align-items: flex-start !important; gap: 16px;">
            <div class="commercial-feature-icon" style="width: 44px; height: 44px; border-radius: 50%; background: rgba(182, 154, 112, 0.14); border: 1px solid rgba(182, 154, 112, 0.35); display: flex; align-items: center; justify-content: center; color: #B69A70; flex-shrink: 0; margin-top: 2px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="4"></circle><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"></line><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"></line><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"></line><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"></line></svg>
            </div>
            <div>
              <strong style="font-size: 15px; font-weight: 600; color: #FFFFFF !important; display: block; margin-bottom: 4px; letter-spacing: 0.02em;">Anti-Glare COB Downlights (UGR &lt; 19 &bull; Ra &ge; 95)</strong>
              <span style="font-size: 13px; color: rgba(255, 255, 255, 0.68) !important; line-height: 1.6; display: block;">Deep recessed architectural optics providing glare-free visual comfort and museum-grade color rendition.</span>
            </div>
          </li>

          <li class="commercial-feature-item" style="list-style: none !important; display: flex !important; align-items: flex-start !important; gap: 16px;">
            <div class="commercial-feature-icon" style="width: 44px; height: 44px; border-radius: 50%; background: rgba(182, 154, 112, 0.14); border: 1px solid rgba(182, 154, 112, 0.35); display: flex; align-items: center; justify-content: center; color: #B69A70; flex-shrink: 0; margin-top: 2px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
            </div>
            <div>
              <strong style="font-size: 15px; font-weight: 600; color: #FFFFFF !important; display: block; margin-bottom: 4px; letter-spacing: 0.02em;">Seamless Architectural Profiles &amp; Dot-Free LED Strips</strong>
              <span style="font-size: 13px; color: rgba(255, 255, 255, 0.68) !important; line-height: 1.6; display: block;">Trimless plaster-in cove profiles, drywall channels, and flexible silicone extrusions for crisp linear light.</span>
            </div>
          </li>
        </ul>

        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="#trade" class="btn btn-primary" style="padding: 15px 28px; font-size: 11.5px; letter-spacing: 0.1em;">
            Submit Project BoQ / Floor Plan
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="/collections/all" class="btn btn-outline-white" style="padding: 15px 24px; font-size: 11.5px; letter-spacing: 0.1em;">
            Explore All Fixtures
          </a>
        </div>
      </div>

      <!-- Right Column: Architectural Typologies Bento Cards -->
      <div>
        <div class="commercial-typologies-grid">
          <div class="commercial-typology-card" style="background: #1F1F1F; border: 1px solid #3D3935; border-radius: 6px; padding: 28px 24px; position: relative; overflow: hidden;">
            <span class="commercial-typology-num" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: #B69A70; margin-bottom: 12px; font-weight: 600;">01 / Retail</span>
            <h4 style="font-size: 18px; font-family: var(--font-serif); color: #FFFFFF !important; margin: 0 0 8px;">Boutique Retail</h4>
            <p style="font-size: 13px; color: rgba(255, 255, 255, 0.68); line-height: 1.6; margin: 0;">Highlight merchandise with focused beam angles (15&deg;&ndash;36&deg;) and high CRI 97+ for true color accuracy.</p>
          </div>

          <div class="commercial-typology-card" style="background: #1F1F1F; border: 1px solid #3D3935; border-radius: 6px; padding: 28px 24px; position: relative; overflow: hidden;">
            <span class="commercial-typology-num" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: #B69A70; margin-bottom: 12px; font-weight: 600;">02 / Hospitality</span>
            <h4 style="font-size: 18px; font-family: var(--font-serif); color: #FFFFFF !important; margin: 0 0 8px;">Hotels &amp; Dining</h4>
            <p style="font-size: 13px; color: rgba(255, 255, 255, 0.68); line-height: 1.6; margin: 0;">Warm dimmable 2400K&ndash;3000K mood lighting, architectural wall-grazing, and heroic foyer centerpieces.</p>
          </div>

          <div class="commercial-typology-card" style="background: #1F1F1F; border: 1px solid #3D3935; border-radius: 6px; padding: 28px 24px; position: relative; overflow: hidden;">
            <span class="commercial-typology-num" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: #B69A70; margin-bottom: 12px; font-weight: 600;">03 / Corporate</span>
            <h4 style="font-size: 18px; font-family: var(--font-serif); color: #FFFFFF !important; margin: 0 0 8px;">Offices &amp; Co-Work</h4>
            <p style="font-size: 13px; color: rgba(255, 255, 255, 0.68); line-height: 1.6; margin: 0;">Circadian rhythm glare-free task illumination (UGR &lt; 19) supporting focus and productivity.</p>
          </div>

          <div class="commercial-typology-card" style="background: #1F1F1F; border: 1px solid #3D3935; border-radius: 6px; padding: 28px 24px; position: relative; overflow: hidden;">
            <span class="commercial-typology-num" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: #B69A70; margin-bottom: 12px; font-weight: 600;">04 / Residential</span>
            <h4 style="font-size: 18px; font-family: var(--font-serif); color: #FFFFFF !important; margin: 0 0 8px;">Villas &amp; Penthouses</h4>
            <p style="font-size: 13px; color: rgba(255, 255, 255, 0.68); line-height: 1.6; margin: 0;">Seamless integration of hidden cove profiles, 48V magnetic tracks, and bespoke custom chandeliers.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

