{% comment %}
  Trade Program & Architect RFQ Form Section
{% endcomment %}

<section class="section" style="padding: 70px 0 100px;">
  <div class="container" style="max-width: 860px;">
    <div class="text-center">
      <span class="eyebrow">Trade & B2B Partner Portal</span>
      <h1 class="section-title">Architect & Interior Designer Program</h1>
      <p class="section-subtitle">
        We partner with leading architects, interior designers, MEP consultants, and builders. Submit your project requirements, CAD plans, or Bill of Quantities (BoQ) for volume commercial pricing and dedicated engineering support.
      </p>
    </div>

    <div style="background: var(--color-cream); border: 1px solid var(--color-border); padding: 40px; border-radius: var(--radius-sm);">
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <div style="background: #E8F5E9; color: #2E7D32; padding: 18px; border-radius: var(--radius-sm); margin-bottom: 24px; text-align: center;">
            <strong>Thank you!</strong> Your project inquiry has been received. Our Pune commercial lighting specialist will contact you with a customized BoQ quote within 24 hours.
          </div>
        {% endif %}

        {% if form.errors %}
          <div style="background: #FFEBEE; color: #C62828; padding: 18px; border-radius: var(--radius-sm); margin-bottom: 24px;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="form-row-2col">
          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">Full Name *</label>
            <input type="text" name="contact[name]" required style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #FFF;">
          </div>
          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">Firm / Practice Name *</label>
            <input type="text" name="contact[firm]" required style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #FFF;">
          </div>
        </div>

        <div class="form-row-2col">
          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">Phone / WhatsApp *</label>
            <input type="tel" name="contact[phone]" required style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #FFF;">
          </div>
          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">Email Address *</label>
            <input type="email" name="contact[email]" required style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #FFF;">
          </div>
        </div>

        <div class="form-row-2col">
          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">Project Typology</label>
            <select name="contact[project_type]" style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #FFF;">
              <option>Luxury Residential Villa / Penthouse</option>
              <option>High-End Retail Showroom</option>
              <option>Restaurant / Cafe / Hospitality</option>
              <option>Corporate Office / Tech Park</option>
              <option>Boutique Hotel</option>
            </select>
          </div>
          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">Project City / Location</label>
            <input type="text" name="contact[location]" placeholder="e.g. Pune, Mumbai, Bangalore" style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #FFF;">
          </div>
        </div>

        <div style="margin-bottom: 24px;">
          <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">Project Scope & Fixture Details</label>
          <textarea name="contact[body]" rows="4" placeholder="Detail your requirements: quantities, custom chandelier diameters, magnetic track run lengths, required CCT, dimming protocol (DALI, 0-10V, Triac), or expected timeline." style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #FFF;"></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 16px;">
          Submit Project For Commercial Quotation
        </button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trade RFQ Form",
  "settings": []
}
{% endschema %}
